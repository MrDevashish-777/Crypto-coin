# CoinDCX Futures Advisor Bot
ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=planitt
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=20000
MONGODB_SOCKET_TIMEOUT_MS=45000

COINDCX_MARGIN_CURRENCIES=USDT,INR
COINDCX_DEFAULT_MARGIN=USDT

# Advisor signal quality (stricter defaults for higher win rate)
ADVISOR_MIN_CONFIDENCE=0.75
ADVISOR_MIN_CONFLUENCE_HITS=4
ADVISOR_MIN_AGREEING_SOURCES=5
ADVISOR_MIN_VOTE_MARGIN=0.18
ADVISOR_MIN_COMPOSITE_SCORE=0.82
ADVISOR_MIN_MTF_SCORE=0.75
ADVISOR_PUBLISH_MIN_QUALITY_TIER=B
ADVISOR_MTF_SCORE_WEIGHT=0.20
ADVISOR_BLOCK_NEGATIVE_BUCKETS=true
ADVISOR_SYMBOL_COOLDOWN_HOURS=6
ADVISOR_STRICT_ALLOCATION=false
ADVISOR_BACKTEST_QUALITY_GATE_ENABLED=false
ADVISOR_BACKTEST_MIN_EXPECTANCY=0.085
ADVISOR_QUALITY_TIER_A_MIN=0.88
ADVISOR_QUALITY_TIER_B_MIN=0.78
MAX_WEEKLY_SIGNALS=100
MAX_DAILY_SIGNALS=25
MAX_PUBLISH_PER_SCAN=5
ADVISOR_TARGET_DAILY_SIGNALS=5
ADVISOR_SCAN_TIMEFRAMES=1h,4h,1d
ADVISOR_ALLOWED_DIRECTIONS=ALL
ADVISOR_BLOCKED_TIMEFRAMES=
ADVISOR_BLOCK_SWING_HORIZON=false
ADVISOR_LIVE_PERFORMANCE_GATE_ENABLED=true
ADVISOR_LIVE_MIN_BUCKET_TRADES=2
ADVISOR_LIVE_MIN_BUCKET_EXPECTANCY=0.0
# SELL guardrails — SOP swing TFs only; require BTC bearish on alts
ADVISOR_SELL_MIN_CONFIDENCE=0.78
ADVISOR_SELL_MIN_COMPOSITE_SCORE=0.86
ADVISOR_SELL_MIN_MTF_SCORE=0.90
ADVISOR_SELL_MIN_CONFLUENCE_HITS=5
ADVISOR_SELL_MIN_AGREEING_SOURCES=6
ADVISOR_SELL_MIN_VOTE_MARGIN=0.20
ADVISOR_SELL_MIN_ADX=26
ADVISOR_SELL_MIN_DI_SPREAD=3.0
ADVISOR_REQUIRE_BTC_BEAR_FOR_SELL=true
ADVISOR_REQUIRE_BTC_BULL_FOR_BUY=false
ADVISOR_SELL_ALLOWED_TIMEFRAMES=4h,1d
ADVISOR_BLOCK_VOLATILE_SELL=true
ADVISOR_SWING_MIN_MTF_SCORE=0.85
ADVISOR_SWING_MIN_AGREEING_SOURCES=5
CHART_RENDERER=matplotlib

# Planitt confluence engine
PLANITT_MIN_CANDLES=205
PLANITT_ADX_TREND_THRESHOLD=20
PLANITT_VOLUME_MULTIPLIER=1.2
PLANITT_TOUCH_TOLERANCE_PCT=0.015
PLANITT_REQUIRE_SWING_STRUCTURE=false
PLANITT_SWING_STRICT_ADX_MAX=26
PLANITT_ALLOW_RANGING_WITH_DIRECTION=true
PLANITT_RANGING_MIN_DI_SPREAD=1.5
PLANITT_ALLOW_VOLATILE_THROUGH_GATES=true
PLANITT_ALLOW_TREND_CONTINUATION=true
PLANITT_TREND_CONTINUATION_ADX=22
PLANITT_REQUIRE_MANDATORY_CATEGORIES=false
PLANITT_RELAX_MOMENTUM=true
PLANITT_MIN_HITS_STRONG_ADX=2
PLANITT_MTF_MIN_AGREEING=1
PLANITT_MTF_ALLOW_RANGING_HTF=true
PLANITT_OPPOSING_PATTERN_VETO_STRENGTH=0.70
PLANITT_RELAX_SIDE_FROM_REGIME=true

# Candlestick patterns
ENABLE_CANDLESTICK_PATTERNS=true
PATTERN_MIN_STRENGTH=0.60
PATTERN_AT_LEVEL_REQUIRED=true

# Nadaraya-Watson Envelope (LuxAlgo, non-repainting — use for live signals)
ENABLE_NWE=true
NWE_BANDWIDTH=8
NWE_MULTIPLIER=3
NWE_LOOKBACK=500
NWE_WEIGHT=0.10
NWE_BAND_TOUCH_PCT=0.003
NWE_TP_SL_ENABLED=true
NWE_TP_SL_MIN_CONFIDENCE=0.80
NWE_SL_BUFFER_ATR_MULT=0.15

# SOP trading parameters
SOP_MIN_SL_PCT=2.5
SOP_MAX_SL_PCT=4.0
SOP_MIN_RR=1.5
SOP_HIGH_CONF_MIN_RR=1.8
SOP_HIGH_CONF_THRESHOLD=0.85
SOP_HIGH_CONF_MIN_SOURCES=6
SOP_LEVERAGED_SL_MIN=18.0
SOP_LEVERAGED_SL_MAX=22.0

ENABLE_BACKGROUND_SCANNER=true
SCAN_INTERVAL=900

PLANITT_PROCESSOR_INTERNAL_API_KEY=change-me

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=0xroyce/plutus
ENABLE_LLM_ANALYSIS=true
# ADVISOR_LLM_SYSTEM_PROMPT_PATH=config/prompts/advisor_narrative_system.md

# Delta Exchange Integration
DELTA_API_KEY=your_demo_api_key
DELTA_API_SECRET=your_demo_api_secret
DELTA_TESTNET=true
DELTA_EXECUTION_ENABLED=true
DELTA_MAX_PORTFOLIO_RISK_PCT=70.0
