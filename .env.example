# CoinDCX Futures Advisor Bot
ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=planitt

COINDCX_MARGIN_CURRENCIES=USDT,INR
COINDCX_DEFAULT_MARGIN=USDT

ADVISOR_MIN_CONFIDENCE=0.70
ADVISOR_MIN_CONFLUENCE_HITS=3
MAX_WEEKLY_SIGNALS=14
ADVISOR_OUTPUT_DIR=output/reports
CHART_RENDERER=matplotlib

ENABLE_ADVISOR_SCANNER=true
ENABLE_BACKGROUND_SCANNER=true
ENABLE_PLANITT_BACKEND=false
SCAN_INTERVAL=900

PLANITT_PROCESSOR_INTERNAL_API_KEY=change-me
CRYPTO_SOURCE_API_KEY=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
ENABLE_LLM_ANALYSIS=true
