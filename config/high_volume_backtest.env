# High-volume 1-week backtest — quality-ranked BUY intraday (15m + 1h)
ADVISOR_SCAN_TIMEFRAMES=15m,1h
ADVISOR_ALLOWED_DIRECTIONS=BUY
ADVISOR_BLOCKED_TIMEFRAMES=4h,1d
ADVISOR_BLOCK_SWING_HORIZON=true
ADVISOR_SYMBOL_ALLOWLIST=SOL,XRP,INJ,ATOM,LINK,TIA,ARB,OP,BCH,AVAX,FIL,NEAR,SUI,SEI

MAX_WEEKLY_SIGNALS=100
MAX_DAILY_SIGNALS=50
ADVISOR_SYMBOL_COOLDOWN_HOURS=0
ADVISOR_ALLOW_MULTI_TF_PER_SYMBOL=true

ADVISOR_BUY_MIN_CONFIDENCE=0.72
ADVISOR_BUY_MIN_COMPOSITE_SCORE=0.82
ADVISOR_BUY_MIN_MTF_SCORE=0.55
ADVISOR_BUY_MIN_CONFLUENCE_HITS=3
ADVISOR_BUY_MIN_AGREEING_SOURCES=3
ADVISOR_BUY_MIN_VOTE_MARGIN=0.10
ADVISOR_BUY_PUBLISH_MIN_QUALITY_TIER=B
ADVISOR_MIN_CONFIDENCE=0.72
ADVISOR_MIN_COMPOSITE_SCORE=0.82
ADVISOR_MIN_MTF_SCORE=0.55
ADVISOR_MIN_CONFLUENCE_HITS=3
ADVISOR_MIN_AGREEING_SOURCES=3
ADVISOR_MIN_VOTE_MARGIN=0.10
ADVISOR_PUBLISH_MIN_QUALITY_TIER=B
ADVISOR_QUALITY_TIER_A_MIN=0.90
ADVISOR_QUALITY_TIER_B_MIN=0.82

PLANITT_ADX_TREND_THRESHOLD=20
PLANITT_REQUIRE_MANDATORY_CATEGORIES=false
PLANITT_MTF_MIN_AGREEING=1
PLANITT_MTF_ALLOW_RANGING_HTF=true
PLANITT_ALLOW_RANGING_WITH_DIRECTION=true
PLANITT_ALLOW_VOLATILE_THROUGH_GATES=true
PLANITT_ALLOW_REVERSAL_SETUPS=false
PLANITT_VOLUME_MULTIPLIER=1.15

ADVISOR_BLOCK_NEGATIVE_BUCKETS=true
ADVISOR_LIVE_PERFORMANCE_GATE_ENABLED=false
ADVISOR_REACHABILITY_K=0.85
ADVISOR_REACHABILITY_AUTO_SWING=false
ENABLE_NWE=true
NWE_TP_SL_ENABLED=true
NWE_TP_SL_MIN_CONFIDENCE=0.80
SOP_MIN_RR=1.2

ADVISOR_SELL_ALLOWED_TIMEFRAMES=
ADVISOR_REQUIRE_BTC_BEAR_FOR_SELL=true

# Return: net_return_pct = net_r × BACKTEST_RISK_PER_TRADE_PCT
BACKTEST_RISK_PER_TRADE_PCT=3.27
