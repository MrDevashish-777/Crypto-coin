# Advisor — aligned to _SOP for Advisors MW.pdf
ADVISOR_SCAN_TIMEFRAMES=1h,4h,1d
ADVISOR_ALLOWED_DIRECTIONS=ALL
ADVISOR_BLOCKED_TIMEFRAMES=
ADVISOR_BLOCK_SWING_HORIZON=false
ADVISOR_USE_SOP_WEIGHTS=true
MAX_WEEKLY_SIGNALS=14
MAX_DAILY_SIGNALS=3
ADVISOR_REACHABILITY_AUTO_SWING=true
ADVISOR_MIN_CONFIDENCE=0.75
ADVISOR_MIN_CONFLUENCE_HITS=4
ADVISOR_MIN_AGREEING_SOURCES=5
ADVISOR_MIN_VOTE_MARGIN=0.18
ADVISOR_MIN_COMPOSITE_SCORE=0.80
ADVISOR_MIN_MTF_SCORE=0.70
ADVISOR_PUBLISH_MIN_QUALITY_TIER=B
PLANITT_MTF_MIN_AGREEING=2
PLANITT_REQUIRE_MANDATORY_CATEGORIES=true
PLANITT_ALLOW_REVERSAL_SETUPS=false
SOP_MAX_SL_PCT=3.0
# Segment tuning (fix SELL / swing / Tier A — do not block)
ADVISOR_SELL_MIN_CONFIDENCE=0.78
ADVISOR_SELL_MIN_COMPOSITE_SCORE=0.86
ADVISOR_SELL_MIN_MTF_SCORE=0.90
ADVISOR_SELL_MIN_CONFLUENCE_HITS=5
ADVISOR_SELL_MIN_AGREEING_SOURCES=6
ADVISOR_SELL_MIN_VOTE_MARGIN=0.20
ADVISOR_SELL_MIN_ADX=24
ADVISOR_SWING_MIN_MTF_SCORE=0.85
ADVISOR_SWING_MIN_AGREEING_SOURCES=5
ADVISOR_LIVE_PERFORMANCE_GATE_ENABLED=false
