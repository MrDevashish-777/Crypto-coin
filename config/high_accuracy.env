# High-accuracy advisor profile — target >=70% WR with >=14 signals/week (SOP)
ADVISOR_HIGH_ACCURACY_MODE=true
ADVISOR_MIN_WEEKLY_SIGNALS=14

# 15m intraday only — live 50%+ WR; 1h/4h/1d underperform
ADVISOR_SCAN_TIMEFRAMES=15m,1h,4h,1d
ADVISOR_BLOCKED_TIMEFRAMES=1m,5m
ADVISOR_BLOCK_SWING_HORIZON=false
ADVISOR_ALLOWED_DIRECTIONS=ALL
ADVISOR_SYMBOL_ALLOWLIST=BTC,ETH,SOL,BNB,XRP,ADA,AVAX,DOGE,LINK,DOT,POL,LTC,BCH,ATOM,NEAR,UNI,APT,ARB,OP,INJ,SUI,TIA,SEI,FIL,AAVE
ADVISOR_PUBLISH_PRIORITY_SYMBOLS=BTC,ETH,SOL,BNB,XRP,AVAX,LINK,ARB,OP,ATOM,SUI,ADA,DOGE,DOT,NEAR,UNI,APT,INJ,TIA,SEI,FIL,AAVE,BCH,LTC,POL
ADVISOR_BLOCK_LOW_CAP_SYMBOLS=true
MIN_WEEKLY_BTC_PCT=0.20
MIN_WEEKLY_MAJORS_PCT=0.35
MAX_WEEKLY_MAJORS_PCT=0.40
ADVISOR_STRICT_ALLOCATION=true
ADVISOR_SELL_ALLOWED_TIMEFRAMES=15m

# Volume: at least 14 signals/week, cap daily noise
MAX_WEEKLY_SIGNALS=28
MAX_DAILY_SIGNALS=6
ADVISOR_TARGET_DAILY_SIGNALS=2
MAX_PUBLISH_PER_SCAN=4
ADVISOR_SYMBOL_COOLDOWN_HOURS_15M=1
ADVISOR_ALLOW_MULTI_TF_PER_SYMBOL=false

# Live bucket gates — block repeat losers
ADVISOR_BLOCK_NEGATIVE_BUCKETS=true
ADVISOR_LIVE_PERFORMANCE_GATE_ENABLED=true
ADVISOR_LIVE_MIN_BUCKET_TRADES=2
ADVISOR_LIVE_MIN_BUCKET_EXPECTANCY=0.0
ADVISOR_LIVE_MIN_BUCKET_WIN_RATE=50

# 15m strict gates
ADVISOR_15M_MIN_CONFIDENCE=0.76
ADVISOR_15M_MIN_COMPOSITE_SCORE=0.86
ADVISOR_15M_MIN_MTF_SCORE=0.55
ADVISOR_15M_MIN_CONFLUENCE_HITS=5
ADVISOR_15M_MIN_AGREEING_SOURCES=7
ADVISOR_15M_MIN_VOTE_MARGIN=0.14
ADVISOR_BUY_PUBLISH_MIN_QUALITY_TIER=A
ADVISOR_SELL_PUBLISH_MIN_QUALITY_TIER=A

ADVISOR_HIGH_ACCURACY_MIN_CONFLUENCE_HITS=5
ADVISOR_HIGH_ACCURACY_MIN_AGREEING_SOURCES=7
ADVISOR_HIGH_ACCURACY_MIN_VOTE_MARGIN=0.14

ADVISOR_BUY_MIN_CONFIDENCE=0.76
ADVISOR_BUY_MIN_COMPOSITE_SCORE=0.86
ADVISOR_BUY_MIN_MTF_SCORE=0.55
ADVISOR_BUY_MIN_CONFLUENCE_HITS=5
ADVISOR_BUY_MIN_AGREEING_SOURCES=7
ADVISOR_BUY_MIN_VOTE_MARGIN=0.14

ADVISOR_SELL_MIN_CONFIDENCE=0.76
ADVISOR_SELL_MIN_COMPOSITE_SCORE=0.86
ADVISOR_SELL_MIN_MTF_SCORE=0.55
ADVISOR_SELL_MIN_CONFLUENCE_HITS=5
ADVISOR_SELL_MIN_AGREEING_SOURCES=7
ADVISOR_SELL_MIN_VOTE_MARGIN=0.14
ADVISOR_SELL_MIN_ADX=22
ADVISOR_SELL_MIN_DI_SPREAD=2.5

ADVISOR_MIN_CONFIDENCE=0.76
ADVISOR_MIN_COMPOSITE_SCORE=0.86
ADVISOR_MIN_MTF_SCORE=0.55
ADVISOR_MIN_CONFLUENCE_HITS=5
ADVISOR_MIN_AGREEING_SOURCES=7
ADVISOR_MIN_VOTE_MARGIN=0.14
ADVISOR_PUBLISH_MIN_QUALITY_TIER=A
ADVISOR_QUALITY_TIER_A_MIN=0.88
ADVISOR_QUALITY_TIER_B_MIN=0.82

# Confluence engine — quality over quantity
PLANITT_15M_ADX_THRESHOLD=16
PLANITT_REQUIRE_MANDATORY_CATEGORIES=true
PLANITT_ALLOW_REVERSAL_SETUPS=false
PLANITT_OPPOSING_PATTERN_VETO_STRENGTH=0.80
PLANITT_VOLUME_MULTIPLIER=1.20
PLANITT_MTF_MIN_AGREEING=1

# Reachability + R:R tuned for higher hit rate
ADVISOR_REACHABILITY_K=0.75
ADVISOR_REACHABILITY_AUTO_SWING=false
SOP_MIN_RR=1.35
NWE_TP_SL_MIN_CONFIDENCE=0.82
ADVISOR_RANGING_TP_SCALE=0.88

ADVISOR_ADAPTIVE_BUCKET_RANKING=true
ADVISOR_POSITIVE_BUCKET_RANK_BOOST=true
